--- uxp-plugin/manifest.json (原始)


+++ uxp-plugin/manifest.json (修改后)
{
  "id": "com.fotozona.photoshop.plugin",
  "name": "Фотозона Pro",
  "version": "2.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "fotozona.main.panel",
      "label": {
        "default": "Фотозона Pro",
        "ru": "Фотозона Pro"
      },
      "minimumSize": {
        "width": 280,
        "height": 400
      },
      "maximumSize": {
        "width": 600,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 700
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon_D.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "light"],
          "species": ["toolbar"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin_icon.png",
      "scale": 1
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": ["https"]
    },
    "network": {
      "domains": ["all"]
    },
    "clipboard": "readAndWrite",
    "allowCodeGenerationFromStrings": true
  }
}
